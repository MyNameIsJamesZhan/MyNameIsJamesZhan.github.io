---
import BaseLayout from "../layouts/BaseLayout.astro";

// Link to photography account; the follow button is hidden while this is empty.
const PHOTOGRAPHY_URL = "https://www.instagram.com/inmyeyes_yunkai/";

// Photos from my Instagram, newest first; each links to its post.
// size: "large" = 2x2 feature tile, "tall" = portrait (1x2), default = 1x1.
const photos = [
  { src: "/photos/photo-01.webp", post: "DdGVvdnG-n_", size: "large" },
  { src: "/photos/photo-02.webp", post: "DdGVN20mwUd" },
  { src: "/photos/photo-03.webp", post: "DZUgn9lG4RK" },
  { src: "/photos/photo-04.webp", post: "DZUgAehmzup" },
  { src: "/photos/photo-05.webp", post: "DZUGwCeFHft", size: "large" },
  { src: "/photos/photo-06.webp", post: "DZUGXO8FMXj", size: "tall" },
  { src: "/photos/photo-07.webp", post: "DX_B0lglXzt", size: "large" },
  { src: "/photos/photo-08.webp", post: "DXGlsQClR1M" },
  { src: "/photos/photo-09.webp", post: "DXGfiYRFSZr", size: "large" },
  { src: "/photos/photo-10.webp", post: "DXGfMnklfNy", size: "tall" },
];

const sizeClass = {
  large: "col-span-2 row-span-2",
  tall: "row-span-2",
};
---

<BaseLayout title="Misc" sideBarActiveItemID="misc">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Misc</div>
  </div>

  <div class="mb-10">
    <div class="text-2xl font-bold mb-3">🏀 Sports</div>
    <p class="text-lg">
      I love watching and playing sports, especially <b>basketball</b> and <b>football</b> (yes, it's called
      football ⚽) — though I'm a fan of <b>American football</b> 🏈 too. Lately I've been exploring new ones like
      <b>golf</b> ⛳ and <b>tennis</b> 🎾. Off the field, I enjoy a good game of <b>poker</b> ♠️.
    </p>
  </div>

  <div class="mb-10">
    <div class="text-2xl font-bold mb-3">📷 Photography</div>
    <p class="text-lg">
      I'm a <b>street photographer</b> and especially enjoy shooting <b>film</b>. Feel free to follow my photography
      account!
    </p>
    <div class="mt-5 grid grid-cols-2 md:grid-cols-3 grid-flow-dense auto-rows-[7rem] sm:auto-rows-[9rem] lg:auto-rows-[11rem] gap-3">
      {
        photos.map((photo) => (
          <a
            href={`https://www.instagram.com/p/${photo.post}/`}
            target="_blank"
            class={`block overflow-hidden rounded-lg ${sizeClass[photo.size] ?? ""}`}
          >
            <img
              src={photo.src}
              alt="Street photography by Yunkai Zhan"
              loading="lazy"
              class="w-full h-full object-cover transition ease-in-out hover:opacity-90 hover:scale-[102%]"
            />
          </a>
        ))
      }
    </div>
    {
      PHOTOGRAPHY_URL && (
        <div class="mt-4">
          <a href={PHOTOGRAPHY_URL} target="_blank" class="btn btn-outline">Instagram @inmyeyes_yunkai</a>
        </div>
      )
    }
  </div>
</BaseLayout>
